# Local values that work with `docker compose -f compose.dev.yaml up -d`.
# Copy this file to .env for local work; .env is never committed.
# When 6379 or 4222 is taken on the host, start the stack with DEV_REDIS_PORT / DEV_NATS_PORT set
# and use the same ports below.

# Port of the WebSocket endpoint.
PORT=3001

# Redis, for presence and the fan-out between instances.
REDIS_URL=redis://localhost:6379

# NATS JetStream broker, reached through @cadenway/nest-messaging.
NATS_URL=nats://localhost:4222
