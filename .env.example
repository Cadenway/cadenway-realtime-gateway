# Local values that work with `docker compose -f compose.dev.yaml up -d` and `pnpm start:dev`,
# which loads .env. Copy this file to .env for local work; .env is never committed.
# When 6379 or 4222 is taken on the host, start the stack with DEV_REDIS_PORT / DEV_NATS_PORT set
# and use the same ports below.
# Every variable the gateway reads is validated at start-up: a missing or invalid one stops it with
# a ConfigError that names it.

# Runtime environment: development, test or production (the default).
NODE_ENV=development
# Port of the WebSocket endpoint and the health routes.
PORT=3001
# trace, debug, info (the default), warn, error, fatal or silent.
LOG_LEVEL=info
# true writes readable lines through pino-pretty instead of JSON; refused in production.
LOG_PRETTY=false
# Collector of traces and metrics, an http or https URL. Empty: spans still give the logs their
# trace ids, and nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Redis, for the fan-out between instances and, later, presence.
REDIS_URL=redis://localhost:6379

# Browser origins allowed to open a socket, comma-separated, exact (no path, no trailing slash,
# never *): the web application only. This is its host on the cadenway-ops local stack; add the
# address of a development server when you run one, such as http://localhost:4200.
ALLOWED_ORIGINS=http://app.cadenway.localhost

# Internal token: the gateway signs the calls it makes to the services with its own Ed25519 key.
# No private key is committed, not even a development one: the gateway refuses to start until
# INTERNAL_TOKEN_PRIVATE_JWK holds one. To get one, from ../cadenway-ops/compose, once its .env
# exists (`cp .env.example .env` there: it names the file that defines the key generator):
#   docker compose run --rm internal-token-keys --print
# prints a fresh pair per issuer on the terminal and writes nothing; put the value of
# REALTIME_GATEWAY_INTERNAL_TOKEN_PRIVATE_JWK here, between single quotes. A service run on the
# host trusts the gateway once its INTERNAL_TOKEN_TRUSTED_ISSUERS lists the public key of that pair.
INTERNAL_TOKEN_ISSUER=realtime-gateway
INTERNAL_TOKEN_PRIVATE_JWK=

# Base URL of each internal service the gateway calls, run on the host with its own
# `pnpm start:dev`, at the local port its repository documents. Nothing calls them yet: the
# handshake ticket (identity) and the room permissions (task) arrive with the connection module.
IDENTITY_SERVICE_URL=http://localhost:3010
TASK_SERVICE_URL=http://localhost:3013

# NATS JetStream broker, reached through @cadenway/nest-messaging: one nats:// or tls:// URL, or
# several separated by commas. The gateway waits for the broker at start-up and refuses to start
# when the EVENTS stream does not exist (`nats-streams` of compose.dev.yaml creates it). Every
# broker checks the user realtime-gateway and its password: the one below is that of the local
# broker of compose.dev.yaml; the cadenway-ops local stack uses its REALTIME_GATEWAY_NATS_PASSWORD.
NATS_URL=nats://localhost:4222
REALTIME_GIT_RELAYS_ENABLED=false
NATS_USER=realtime-gateway
NATS_PASSWORD=realtimegateway
